<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<div class="container app-shell">
    <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand fw-bold text-primary d-flex align-items-center brand-lockup" href="${pageContext.request.contextPath}/packages">
            <img src="${pageContext.request.contextPath}/assets/images/brand-crest.svg" alt="Wedding Package Management logo" class="brand-crest" />
            <span class="brand-copy">
                <span class="brand-overline">Wedding Suite</span>
                <span class="brand-title">Wedding Package Management</span>
            </span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item me-3">
                    <span class="nav-link welcome-pill">Hello, <strong>${sessionScope.user.fullName}</strong></span>
                </li>
                <li class="nav-item">
                    <a class="btn btn-outline-primary btn-sm" href="${pageContext.request.contextPath}/logout">Logout</a>
                </li>
            </ul>
        </div>
    </nav>
</div>
